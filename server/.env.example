# Copy this file to .env and fill in real values before running the server.

# Server
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Initial admin account (only used the first time the DB is created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# SMTP (used to send contact-form emails). Works with Gmail SMTP, SendGrid,
# Resend, Mailgun, or any other provider's SMTP relay.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# The address contact-form emails are sent FROM (must usually be a verified
# sender/domain with your SMTP provider).
MAIL_FROM=Impact Website <no-reply@impactegypt.com>

# Country-based routing for the contact form.
# If the submitted "country" contains "egypt" (case-insensitive), the
# message goes to MAIL_TO_EGYPT. Otherwise it goes to MAIL_TO_DEFAULT
# (UAE, KSA, and every other country).
MAIL_TO_EGYPT=info@impactegypt.com
MAIL_TO_DEFAULT=info@impact-ld.me
